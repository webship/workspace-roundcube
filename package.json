{
  "name": "@webship.co/workspace-roundcube",
  "version": "1.0.0",
  "description": "Roundcube for Webship Workspace: the builder (`cmd-roundcube-project.sh`) in every sites folder, a webmail with a mail server of its own beside it (GreenMail), its database made by its own installer, the workspace account's mailbox and the default accounts (alice and bob), the sample data (mails, a folder, contacts and a group, a response), the webmail's tool (`cmd-tools-roundcube-cli.sh`), the Roundcube step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-roundcube.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "roundcube",
    "label": "Roundcube",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-roundcube-project.sh",
        "commands/cmd-tools-roundcube-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-roundcube.sh"
      ],
      "args": [
        "scripts/args/arg-roundcube.sh",
        "scripts/args/arg-roundcube-cli.sh"
      ],
      "machine": [
        "testing/webmail.feature",
        "scripts/mail-site.php"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/roundcube-site-builder.md",
        "ai/agents/roundcube-tester.md"
      ],
      "skills": [
        "ai/skills/roundcube-scenarios"
      ],
      "commands": [
        "ai/commands/roundcube-test.md"
      ],
      "prompts": [
        "ai/prompts/roundcube-build-and-test.md",
        "ai/prompts/roundcube-mail-round.md"
      ]
    },
    "features": [
      "features/roundcube.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
